@startuml
title OBJETIVO: Enviar e buscar dados (hello flask 3)

actor usuario as "Usuário"
boundary browser as "browser"
control flask as "Flask"

usuario -> browser : acessa
activate browser
activate flask
browser -> flask : HTTP GET /
flask --> browser : HTML
browser --> usuario : exibe a página

== Interação local no navegador ==

usuario -> browser : clica no botão
browser -> flask : HTTP POST /api/post-hello (JSON)

flask --> browser : mensagem (JSON)
deactivate flask

browser -> browser : textContent(mensagem)
browser --> usuario : pagina atualizada
deactivate browser

@enduml

